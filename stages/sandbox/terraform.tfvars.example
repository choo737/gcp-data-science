# Replace placeholder IDs inside untracked custom.auto.tfvars, never inside tracked files.
project_id                  = "example-sandbox-project"
region                      = "asia-southeast1"
prefix                      = "bqfnd"
create_silver_dataset       = true
create_ml_audit_dataset     = true
ds_serving_track            = "bqml_batch"
enable_online_feature_store = false
enable_scorer_service       = false
enable_bqml_schedule        = false
delete_contents_on_destroy  = false
