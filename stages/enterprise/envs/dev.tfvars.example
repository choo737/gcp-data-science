# Link upstream gcp-foundation dev outputs via scripts/link-stages.sh --env dev before apply.
environment                   = "dev"
prefix                        = "ent-dev"
region                        = "asia-southeast1"
ds_serving_track              = "bqml_batch"
enable_bqml_schedule          = false
enable_online_feature_store   = false
enable_scorer_service         = false
deploy_cpr_model              = false
fairness_min_disparate_impact = 0.80
shap_additivity_tolerance     = 0.00001
